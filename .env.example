# =============================================================================
# API Gateway Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed for your environment.

# =============================================================================
# Redis Configuration
# =============================================================================
# URL for Redis connection (used for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Maximum number of Redis connections in the pool
REDIS_MAX_CONNECTIONS=10


# =============================================================================
# vLLM Backend Configuration
# =============================================================================
# JSON mapping of model names to their vLLM backend URLs
# Format: {"model-name": "http://host:port"}
# Example: {"qwen2.5-coder-1.5b": "http://localhost:11434", "qwen2.5-coder-32b": "http://localhost:8001"}
VLLM_BACKENDS={"default": "http://localhost:11434"}


# =============================================================================
# Timeout Configuration (seconds)
# =============================================================================
# Connection timeout
DEFAULT_TIMEOUT_CONNECT=5.0

# Read timeout (for long-running model inference)
DEFAULT_TIMEOUT_READ=300.0

# Write timeout
DEFAULT_TIMEOUT_WRITE=10.0

# Pool acquisition timeout
DEFAULT_TIMEOUT_POOL=5.0


# =============================================================================
# Rate Limiting
# =============================================================================
# Default rate limit for requests (format: "number/interval")
# Examples: "100/minute", "5000/hour", "100000/day"
RATE_LIMIT_DEFAULT=100/minute


# =============================================================================
# API Keys
# =============================================================================
# Path to the JSON file containing API keys
# Format: [{"key": "sk-...", "name": "client-name", "rate_limit": "100/minute"}]
API_KEYS_FILE=data/api_keys.json


# =============================================================================
# Logging
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
